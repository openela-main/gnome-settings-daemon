index 56e054ca..36f4b3b1 100644
--- a/plugins/housekeeping/gsd-disk-space-helper.c
+++ b/plugins/housekeeping/gsd-disk-space-helper.c
@@ -50,6 +50,8 @@ gsd_should_ignore_unix_mount (GUnixMountEntry *mount)
                 "auto",
                 "autofs",
                 "autofs4",
+                "binfmt_misc",
+                "bpf",
                 "cgroup",
                 "configfs",
                 "cxfs",
