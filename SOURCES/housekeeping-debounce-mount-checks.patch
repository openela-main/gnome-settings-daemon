                 "devtmpfs",
                 "ecryptfs",
+                "efivarfs",
                 "fdescfs",
                 "fusectl",
                 "gfs",
@@ -86,6 +89,7 @@ gsd_should_ignore_unix_mount (GUnixMountEntry *mount)
                 "selinuxfs",
                 "sysfs",
                 "tmpfs",
+                "tracefs",
                 "usbfs",
                 "zfs",
                 NULL
