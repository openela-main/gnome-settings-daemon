                    GAsyncResult *res,
                    gpointer      user_data)
 {
+        GsdPowerManager *manager = GSD_POWER_MANAGER (user_data);
         g_autoptr(GError) error = NULL;
         g_autoptr(GVariant) result = NULL;
 
         result = g_dbus_proxy_call_finish (G_DBUS_PROXY (source_object),
