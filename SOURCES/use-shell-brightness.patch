-	int fd, len, res;
-	int uid, euid;
-	int brightness;
-	int result = GSD_BACKLIGHT_HELPER_EXIT_CODE_FAILED;
-	DIR *dp = NULL;
-	struct dirent *ep;
-
-	/* check calling UID */
